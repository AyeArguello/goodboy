# Copy to .env.local for development. Never commit real secrets.
# See docs/assumptions.md for what's confirmed vs. pending, and
# lib/config/business.ts / lib/env/*.ts for how these are validated.
#
# NAP, WhatsApp, hours, address and the deposit amount are CONFIRMED and
# hardcoded in lib/config/business.ts — they are not env vars anymore.

# ---- Site ----
# Real production domain: goodboy.com.ar (confirmed available — see
# docs/plan-web-good-boy.md #2; still needs to actually be registered before
# launch). Required in production (build fails without it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# Point these at your local stack (`pnpm supabase:start` prints them) or a
# real project. Anon key is public by design; service role must stay secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMACs the caller IP before it's used as a rate-limit key (never store raw
# IPs — see lib/security/rateLimitKey.ts). Rotate freely in production; that
# just resets everyone's rate-limit window, nothing leaks.
RATE_LIMIT_HMAC_SECRET=

# Comma-separated emails allowed to sign in to /admin. Confirmed: ayelearguello.aa@gmail.com
ADMIN_EMAIL_ALLOWLIST=ayelearguello.aa@gmail.com

# ---- Business data still pending confirmation (docs/assumptions.md #2) ----
# Production build fails if these are missing.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_BUSINESS_CANCELLATION_POLICY_TEXT=
# The card-surcharge-by-installments model itself (1 cuota 7% / 3 cuotas
# 10.5%) is hardcoded, disabled, in lib/config/business.ts
# (`deposit.paymentOptions.enabled = false`) pending legal/accounting review
# — see docs/auditoria-seguridad-y-cumplimiento-good-boy.md. There is no env
# var for it: flipping it on is a one-line code change made deliberately,
# not something that should silently turn on via configuration.

# Lower-priority pending copy (shown as [PENDIENTE] in the UI until set;
# does not block the production build).
NEXT_PUBLIC_SIZE_REF_PEQUENO_KG=
NEXT_PUBLIC_SIZE_REF_MEDIANO_KG=
NEXT_PUBLIC_SIZE_REF_GRANDE_KG=
NEXT_PUBLIC_RESPONSE_TIME_TEXT=
# Hours the client has to pay the deposit after approval. Defaults to 24 if unset.
NEXT_PUBLIC_DEPOSIT_DUE_HOURS=24

# ---- Notifications (optional; noop adapter used in dev if unset) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# ---- Feature flags (off by default; see docs/assumptions.md #3) ----
NEXT_PUBLIC_FEATURE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- SEO ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
