# Copy to .env.local for development. Never commit real secrets.
# See docs/assumptions.md for what's confirmed vs. pending, and
# lib/config/business.ts / lib/env/*.ts for how these are validated.
#
# NAP, WhatsApp, hours, address and the deposit amount are CONFIRMED and
# hardcoded in lib/config/business.ts — they are not env vars anymore.

# ---- Site ----
# Real production domain: goodboy.com.ar (confirmed available — see
# docs/plan-web-good-boy.md #2; still needs to actually be registered before
# launch). Required in production (build fails without it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# Point these at your local stack (`pnpm supabase:start` prints them) or a
# real project. The variable names stay compatible with the application, but
# hosted environments should use a publishable `sb_publishable_...` key and a
# revocable server-only `sb_secret_...` key. Never expose the latter.
# `pnpm build` (production) fails unless the URL is an https:// hosted project
# (not localhost) and both keys plus RATE_LIMIT_HMAC_SECRET (min 32 chars) and
# ADMIN_EMAIL_ALLOWLIST are set to real, non-default values — see
# lib/config/productionGate.ts.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMACs the caller IP before it's used as a rate-limit key (never store raw
# IPs — see lib/security/rateLimitKey.ts). Rotate freely in production; that
# just resets everyone's rate-limit window, nothing leaks.
RATE_LIMIT_HMAC_SECRET=

# Comma-separated emails allowed to sign in to /admin. Use the owner's real address in the hosting settings, never in Git
ADMIN_EMAIL_ALLOWLIST=owner@example.com

# ---- Confirmed business data, supplied through deployment configuration ----
# Production build fails if these are missing.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_BUSINESS_CANCELLATION_POLICY_TEXT=
# The card-surcharge-by-installments model itself (1 cuota 7% / 3 cuotas
# 10.5%) is hardcoded, disabled, in lib/config/business.ts
# (`deposit.paymentOptions.enabled = false`) pending legal/accounting review
# — see docs/auditoria-seguridad-y-cumplimiento-good-boy.md. There is no env
# var for it: flipping it on is a one-line code change made deliberately,
# not something that should silently turn on via configuration.

# The deposit deadline is confirmed and hardcoded as 24 hours in business.ts.

# ---- Email (the only automatic channel) ----
# Optional in dev (a no-op mailer logs instead). REQUIRED in production: the
# payment instructions and the receipt-upload link travel by email, and the
# owner is alerted to every receipt. `pnpm build` fails without them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# ---- Deposit by manual bank transfer ----
# Shown in the approval email and on the receipt-upload page. Business data:
# never invented here. The alias is required in production.
DEPOSIT_TRANSFER_ALIAS=
DEPOSIT_TRANSFER_HOLDER=
DEPOSIT_TRANSFER_CBU=

# ---- Feature flags (off by default; see docs/assumptions.md #3) ----
NEXT_PUBLIC_FEATURE_TURNSTILE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- SEO ----
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
